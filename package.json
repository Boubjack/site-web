{
  "name": "infinity-football",
  "version": "1.0.0",
  "description": "Infinity Football — Football Life Simulator. Moteur de simulation complet (monde ouvert, IA, économie, carrière, médias, héritage).",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "npm run build && node --test \"dist/tests/*.test.js\"",
    "simulate": "npm run build && node dist/src/devtools/headless-runner.js",
    "web": "npm run build && node dist/src/devtools/web-server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
