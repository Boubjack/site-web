# Connection string Postgres (Neon). Créez un projet gratuit sur https://neon.tech
# puis copiez la "pooled connection string".
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Secret utilisé pour signer les sessions (JWT). Mettez une longue valeur aléatoire.
JWT_SECRET=change-me-to-a-long-random-secret

# Identifiants du Control Center (espace admin). Changez-les avant la mise en production.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
ADMIN_SECRET_KEY=change-me-secret-key

# Stripe (clés de test sur https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# URL de base utilisée pour les redirections Stripe (success/cancel)
BASE_URL=http://localhost:5173

# Optionnel : active les réponses ChatGPT réelles dans le Control Center (sinon mode démo)
OPENAI_API_KEY=
