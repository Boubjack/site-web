# ============================================================
# E-Market — variables d'environnement
# Copier ce fichier vers .env puis renseigner les valeurs.
# NE JAMAIS committer le fichier .env réel.
# ============================================================

# Port du serveur HTTP
PORT=3000

# Secret JWT (authentification) — générer une valeur aléatoire longue
JWT_SECRET=changez-moi-avec-une-valeur-aleatoire-longue

# ------------------------------------------------------------
# E-Market AI — fournisseur de modèles de TEXTE (gratuit d'abord)
# ------------------------------------------------------------
# Choix du fournisseur : auto | anthropic | openrouter | ollama | none
# 'auto' (défaut) prend le premier fournisseur configuré ci-dessous ; sans
# aucune clé, E-Market AI tourne en "mode local" (moteur de règles sur le
# catalogue) — tout le site reste fonctionnel, gratuitement, hors ligne.
LLM_PROVIDER=auto

# Anthropic (Claude) — optionnel, clé UNIQUEMENT côté serveur.
ANTHROPIC_API_KEY=
EMARKET_AI_MODEL=claude-opus-4-8
EMARKET_AI_FAST_MODEL=claude-haiku-4-5

# OpenRouter — accès GRATUIT à de nombreux modèles open source.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Ollama — modèles LOCAUX (100 % gratuit, hors ligne). Ex. http://localhost:11434
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1

# ------------------------------------------------------------
# Recherche sémantique / mémoire vectorielle
# ------------------------------------------------------------
# local = index cosinus pur-JS (gratuit, sans dépendance, hors ligne)
# faiss = index FAISS externe + embeddings modèle (montée en volume)
VECTOR_PROVIDER=local
VECTOR_DIMS=256

# ------------------------------------------------------------
# AI Photo Pro / AI Video Pro — moteurs de rendu (optionnels).
#
# Sans moteur (valeur "none"), les studios produisent le DOSSIER DE PRODUCTION
# professionnel complet (specs, pipeline, storyboard, plans caméra, voix-off,
# musique) et un job de rendu en attente. Brancher un moteur (Replicate,
# Stability, Runway, Sora…) active le rendu réel des pixels 4K/8K à partir de
# ces mêmes specs — sans changer le reste du code (adaptateurs).
# ------------------------------------------------------------
# Génération d'images — moteurs OSS recommandés : flux (FLUX.1 Dev), sdxl.
IMAGE_PROVIDER=none            # none | flux | sdxl | replicate | stability | custom
IMAGE_PROVIDER_API_KEY=
IMAGE_MAX_RESOLUTION=4k        # 1080p | 2k | 4k | 8k

# Post-traitement image OSS (super-résolution, détourage, détection, OCR).
UPSCALE_PROVIDER=real-esrgan   # real-esrgan | none  (Real-ESRGAN)
BG_REMOVAL_PROVIDER=rmbg-2.0   # rmbg-2.0 | none     (RMBG-2.0)
DETECTION_PROVIDER=yolo        # yolo | none         (YOLO)
OCR_PROVIDER=paddleocr         # paddleocr | none    (PaddleOCR)

# Génération vidéo — moteurs OSS : ltx (LTX-Video), wan (Wan 2.2).
VIDEO_PROVIDER=none            # none | ltx | wan | runway | pika | custom
VIDEO_PROVIDER_API_KEY=
VIDEO_MAX_RESOLUTION=4k        # 1080p | 2k | 4k | 8k

# Voix-off (TTS) et musique — moteurs OSS : coqui/piper (TTS), musicgen.
TTS_PROVIDER=none              # none | coqui | piper | elevenlabs | custom
TTS_PROVIDER_API_KEY=
MUSIC_PROVIDER=none            # none | musicgen | suno | custom
MUSIC_PROVIDER_API_KEY=
