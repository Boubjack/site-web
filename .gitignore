# ---------------------------------------------------------------------------
# Infinity Football — root .gitignore
# ---------------------------------------------------------------------------

# Build output ---------------------------------------------------------------
/Builds/*
!/Builds/.gitignore
!/Builds/README.md
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe

# Runtime output -------------------------------------------------------------
/Logs/*
!/Logs/.gitignore
!/Logs/README.md
/Saves/*
!/Saves/.gitignore
!/Saves/README.md

# Editors / IDEs -------------------------------------------------------------
.vscode/
.idea/
*.swp
*.user
.cache/

# OS -------------------------------------------------------------------------
.DS_Store
Thumbs.db
