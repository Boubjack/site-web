# ============================================================
# E-Market — variables d'environnement
# Copier ce fichier vers .env puis renseigner les valeurs.
# NE JAMAIS committer le fichier .env réel.
# ============================================================

# Port du serveur HTTP
PORT=3000

# Secret JWT (authentification) — générer une valeur aléatoire longue
JWT_SECRET=changez-moi-avec-une-valeur-aleatoire-longue

# ------------------------------------------------------------
# E-Market AI — fournisseur de modèles
# ------------------------------------------------------------
# Clé API Anthropic (Claude). Utilisée UNIQUEMENT côté serveur.
# Sans clé, E-Market AI fonctionne en "mode local" (moteur de règles
# sur le catalogue) — utile en développement.
ANTHROPIC_API_KEY=

# Modèle conversationnel principal
EMARKET_AI_MODEL=claude-opus-4-8

# Modèle rapide/économique pour les tâches simples (classification, i18n)
EMARKET_AI_FAST_MODEL=claude-haiku-4-5

# ------------------------------------------------------------
# AI Photo Pro / AI Video Pro — moteurs de rendu (optionnels).
#
# Sans moteur (valeur "none"), les studios produisent le DOSSIER DE PRODUCTION
# professionnel complet (specs, pipeline, storyboard, plans caméra, voix-off,
# musique) et un job de rendu en attente. Brancher un moteur (Replicate,
# Stability, Runway, Sora…) active le rendu réel des pixels 4K/8K à partir de
# ces mêmes specs — sans changer le reste du code (adaptateurs).
# ------------------------------------------------------------
IMAGE_PROVIDER=none            # none | replicate | stability | custom
IMAGE_PROVIDER_API_KEY=
IMAGE_MAX_RESOLUTION=4k        # 1080p | 2k | 4k | 8k

VIDEO_PROVIDER=none            # none | runway | pika | sora | custom
VIDEO_PROVIDER_API_KEY=
VIDEO_MAX_RESOLUTION=4k        # 1080p | 2k | 4k | 8k

TTS_PROVIDER=none              # voix-off IA : none | elevenlabs | azure | custom
TTS_PROVIDER_API_KEY=
MUSIC_PROVIDER=none            # musique IA : none | suno | custom
MUSIC_PROVIDER_API_KEY=
